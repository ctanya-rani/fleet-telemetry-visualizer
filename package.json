{
  "name": "fleet-telemetry-visualizer",
  "version": "1.0.0",
  "description": "IoT fleet telemetry visualizer: real-time map, device health, SLA tracking, and event-recorder incident timeline reconstruction",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "fleet-recorder": "src/parser/cli.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "parse": "node src/parser/cli.js",
    "build": "npm test && node demo/build.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "ws": "^8.18.0"
  }
}
